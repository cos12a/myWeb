# ==========================================================================
#  rust-mqtt-backend 生产环境配置模板（dist 自包含版）
# ==========================================================================
#  用法：
#     cp .env.example .env      # 复制为真实配置
#     chmod 600 .env            # 收紧权限（含密钥，务必 600）
#     vim .env                  # 填入真实值（把 <...> 占位符全部替换）
#
#  安全：.env 已被 .gitignore 忽略，绝不入库；只有本 .example 模板入库。
#  加载：程序用 `--env-file=xxx` 指定，默认读同目录 .env；
#        也可用系统环境变量注入（systemd EnvironmentFile= 亦读此格式）。
#
#  校验规则（src/config.rs）：标「必填」的项 trim 后不能为空，否则启动即
#  exit(1) 并一次性打印全部缺失项；标「范围」的项越界同样报错。
# ==========================================================================

# ---------------------------- MQTT ----------------------------
# 【必填】Broker 地址。本机明文用 mqtt://host:port（默认端口 1883）。
#   ⚠️ dist 里的二进制是纯 Rust 构建，不含 TLS，只支持 mqtt://（明文），
#      不支持 mqtts://。如需 TLS，请按 ../DEPLOY.md 路径 A/B 重编。
MQTT_URL=mqtt://127.0.0.1:1883
# 【必填】Broker 用户名
MQTT_USER=<MQTT_USER>
# 【必填】Broker 密码（密钥，勿泄露）
MQTT_PASS=<MQTT_PASS>
# 【可选】客户端 ID，默认 rust-mqtt-consumer。
#   ⚠️ 同一 Broker 上 clientId 必须唯一，重复会互踢。与 Go/Bun 生产进程
#      并行双跑时，务必改成不同 ID（见 .env.debug.example）。
MQTT_CLIENT_ID=rust-mqtt-consumer
# 【可选】订阅主题，默认 sensors/#（QoS 固定为 1）
MQTT_SUBSCRIBE_TOPIC=sensors/#

# -------------------------- InfluxDB 2.x --------------------------
# 【必填】InfluxDB 地址。本机明文 http://127.0.0.1:8086。
#   ⚠️ 同上，dist 二进制不含 TLS，只支持 http://，不支持 https://。
INFLUX_URL=http://127.0.0.1:8086
# 【必填】API Token（密钥，勿泄露）。需对下面 org/bucket 有 write 权限。
INFLUX_TOKEN=<INFLUX_TOKEN>
# 【必填】组织名
INFLUX_ORG=<INFLUX_ORG>
# 【必填】存储桶名（需先在 InfluxDB 里创建）
INFLUX_BUCKET=<INFLUX_BUCKET>

# ---------------------------- 运行时 ----------------------------
# 【可选/范围】日志级别，默认 info。可选：debug / info / warn / error / fatal
#   debug 会打印完整 payload + 字段分类快照（排障用，量大）。
LOG_LEVEL=info
# 【可选/范围】健康检查 HTTP 端口，默认 9004，取值 1~65535。
#   暴露三个只读端点：GET / 、GET /health 、GET /stats
#   ⚠️ 与 Go/Bun 并行双跑时要改成不同端口（如 9005），否则端口冲突。
HEALTH_PORT=9004

# -------------------------- 应用层去重 --------------------------
# 【可选】是否启用去重，默认 true。接受 1/t/true 与 0/f/false。
DEDUP_ENABLED=true
# 【可选/范围】去重 LRU 最大条目数，默认 10000，取值 100~1000000。
DEDUP_MAX_SIZE=10000
# 【可选/范围】去重 key 存活时间(毫秒)，默认 300000(=5分钟)，取值 1000~3600000。
DEDUP_TTL_MS=300000
