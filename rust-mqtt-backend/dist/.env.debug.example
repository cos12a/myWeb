# ==========================================================================
#  rust-mqtt-backend 调试环境配置模板（dist 自包含版）
# ==========================================================================
#  用法：
#     cp .env.debug.example .env.debug && chmod 600 .env.debug && vim .env.debug
#     ./run.sh .env.debug          # 前台用调试配置跑
#
#  与生产环境的隔离三要素（可与 Go/Bun 生产进程并行双跑、互不干扰）：
#     冲突点 1：独立 clientId    —— 避免 MQTT Broker 互踢
#     冲突点 2：独立 bucket      —— 避免数据混写
#     冲突点 3：独立健康检查端口 —— 避免端口占用
# ==========================================================================

# ---------------------------- MQTT ----------------------------
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=<MQTT_USER>
MQTT_PASS=<MQTT_PASS>
# 冲突点 1：独立 clientId，加 -debug 后缀与生产版隔离
MQTT_CLIENT_ID=rust-mqtt-consumer-debug
MQTT_SUBSCRIBE_TOPIC=sensors/#

# -------------------------- InfluxDB 2.x --------------------------
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=<INFLUX_TOKEN>
INFLUX_ORG=<INFLUX_ORG>
# 冲突点 2：独立 bucket（建议设 7 天自动清理），需先在 InfluxDB 里创建
INFLUX_BUCKET=<DEBUG_BUCKET>

# ---------------------------- 运行时 ----------------------------
# debug 级别会打印完整 payload + 字段分类快照
LOG_LEVEL=debug
# 冲突点 3：独立健康检查端口（生产 9004 → 调试 9005）
HEALTH_PORT=9005

# -------------------------- 应用层去重 --------------------------
DEDUP_ENABLED=true
DEDUP_MAX_SIZE=10000
DEDUP_TTL_MS=300000
