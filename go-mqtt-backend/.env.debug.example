# ========== go-mqtt-backend 调试环境配置模板 ==========
# 复制为 .env.debug 并填入真实值（.env.debug 已被 gitignore，绝不入库）
# cp .env.debug.example .env.debug && chmod 600 .env.debug
#
# 与生产环境的隔离点：
#   冲突点 1：独立 clientId（避免 MQTT Broker 互踢）
#   冲突点 2：独立 bucket（避免数据混写）
#   冲突点 3：独立健康检查端口（避免端口占用）

# ---------- MQTT ----------
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=bun_backend
MQTT_PASS=<MQTT_PASS_已隐藏>
# 冲突点 1：独立 clientId
MQTT_CLIENT_ID=go-mqtt-consumer-debug
MQTT_SUBSCRIBE_TOPIC=sensors/#

# ---------- InfluxDB ----------
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=<INFLUX_TOKEN_已隐藏>
INFLUX_ORG=UNITO-ORG
# 冲突点 2：独立 bucket（7 天自动清理）
INFLUX_BUCKET=myHeatTestGoDebug

# ---------- 运行时 ----------
# debug 级别会打印完整 payload + 字段分类快照
LOG_LEVEL=debug
# 冲突点 3：独立健康检查端口
HEALTH_PORT=9003

# ---------- 应用层去重 ----------
DEDUP_ENABLED=true
DEDUP_MAX_SIZE=10000
DEDUP_TTL_MS=300000
