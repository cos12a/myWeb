# ========== go-mqtt-backend 生产环境配置模板 ==========
# 复制为 .env 并填入真实值（.env 已被 gitignore，绝不入库）
# cp .env.example .env && chmod 600 .env

# ---------- MQTT ----------
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=bun_backend
MQTT_PASS=<MQTT_PASS_已隐藏>
MQTT_CLIENT_ID=go-mqtt-consumer
MQTT_SUBSCRIBE_TOPIC=sensors/#

# ---------- InfluxDB ----------
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=<INFLUX_TOKEN_已隐藏>
INFLUX_ORG=UNITO-ORG
INFLUX_BUCKET=myHeatTest

# ---------- 运行时 ----------
LOG_LEVEL=info
HEALTH_PORT=9002

# ---------- 应用层去重 ----------
DEDUP_ENABLED=true
DEDUP_MAX_SIZE=10000
DEDUP_TTL_MS=300000
