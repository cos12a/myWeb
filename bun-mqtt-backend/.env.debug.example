# ==========================================================================
# bun-mqtt-backend · 调试环境模板
# --------------------------------------------------------------------------
# 使用方式：
#   1) cp .env.debug.example .env.debug
#   2) 按需修改下面的敏感字段（MQTT_PASS / INFLUX_TOKEN）
#   3) 启动：bun run dev:debug  或  bun run start:debug
#
# 设计目标：与已在云服务器上运行的"生产版"进程并行调试、互不干扰。
# 冲突规避三要素：
#   ① MQTT_CLIENT_ID  必须与生产版不同（否则 Broker 会互踢）
#   ② INFLUX_BUCKET   写入独立的 debug bucket（避免污染生产数据）
#   ③ HEALTH_PORT     端口错开（避免 EADDRINUSE）
# ==========================================================================

# ---------- MQTT ----------
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USER=bun_backend
MQTT_PASS=请填入密码

# ⚠️ 冲突点 1：clientId 必须唯一，加 -debug 后缀与生产版隔离
MQTT_CLIENT_ID=bun-mqtt-consumer-debug

# 可选：仅订阅测试设备主题，避免与生产版重复消费同一批消息
# 例：sensors/test-+/data  ；留空则默认 sensors/#
# MQTT_SUBSCRIBE_TOPIC=sensors/#

# ---------- InfluxDB ----------
INFLUX_URL=http://127.0.0.1:8086
INFLUX_TOKEN=请填入Token
INFLUX_ORG=UNITO-ORG

# ⚠️ 冲突点 2：写入独立 bucket，先在 InfluxDB 里创建：
#   influx bucket create --name myHeatDemoDebug --retention 7d --org UNITO-ORG
INFLUX_BUCKET=myHeatDemoDebug

# ---------- 运行时 ----------
# ⚠️ 冲突点 3：健康检查端口错开，生产版占 9000，调试版用 9001
HEALTH_PORT=9001

# 调试时开 debug 级别，可以看到每条消息的入队日志
LOG_LEVEL=debug

# ---------- 应用层去重（LRU + TTL）----------
# 防止 MQTT QoS≥1 重投或传感器重发导致 InfluxDB 数据翻倍
# 去重键优先取 payload 里的 messageId/msgId/uuid/id，否则用 Bun.hash(topic+raw)
DEDUP_ENABLED=true

# 缓存最大条目数（100 ~ 1000000），默认 10000
DEDUP_MAX_SIZE=10000

# 单条记录存活时长（1000 ~ 3600000 毫秒），默认 300000 = 5 分钟
DEDUP_TTL_MS=300000
